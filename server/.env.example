# Copy to .env and fill in real values
NODE_ENV=development
PORT=5000

# Local:  mongodb://127.0.0.1:27017/connecthub
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/connecthub?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/connecthub

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_DAYS=7

# Allowed browser origin(s) for CORS + Socket.io. Comma-separate multiple.
CLIENT_URL=http://localhost:5173
